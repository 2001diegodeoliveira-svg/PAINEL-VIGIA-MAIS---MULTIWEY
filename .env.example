# Vigia Mais MT - Configuração de Ambiente

# API Base URL (quando disponível)
VITE_API_BASE_URL=https://mapas.sinfra.mt.gov.br/api

# Modo de desenvolvimento (usa mock data)
VITE_USE_MOCK_DATA=true

# Intervalo de atualização automática (ms)
VITE_REFRESH_INTERVAL=30000

# Configurações do Mapa
VITE_MAP_CENTER_LAT=-15.5961
VITE_MAP_CENTER_LNG=-56.0974
VITE_MAP_ZOOM=5.5

# Identidade Visual
VITE_APP_TITLE=Vigia Mais MT - Sala de Situação
VITE_APP_DESCRIPTION=Painel de monitoramento inteligente do Governo de Mato Grosso

# Feature Flags
VITE_ENABLE_PRESENTATION_MODE=true
VITE_ENABLE_KEYBOARD_NAV=true
VITE_ENABLE_LPR_ALERTS=true

# LGPD / Privacidade
VITE_BLUR_FACES=true
VITE_BLUR_PLATES=true
VITE_PUBLIC_MODE_RESTRICT_STREAMS=true