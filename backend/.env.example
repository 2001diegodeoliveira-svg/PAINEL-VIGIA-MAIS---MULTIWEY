# Vigia Mais MT - Backend Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS - URL do frontend
CORS_ORIGIN=http://localhost:3000

# API Base Path
API_PREFIX=/api

# Log level
LOG_LEVEL=dev

# Mock data toggle (true = usa dados mock, false = tenta conectar banco real)
USE_MOCK_DATA=true